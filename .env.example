# Example environment file for local development.
#
# Copy this to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. NOTE: the FastAPI backend reads DATABASE_URL from the
# process environment only — it does NOT auto-load `.env` (by design). The
# scripts/dev.sh helper exports these values for you; if you run commands by
# hand, export them yourself (e.g. `set -a; source .env; set +a`).

# PostgreSQL connection string used by the backend.
# For the bundled docker-compose database, this is:
DATABASE_URL=postgresql://wlt:wlt@127.0.0.1:5432/wlt

# Base URL the Flet app points at. Defaults to this value if unset.
API_BASE_URL=http://127.0.0.1:8080

# Shared secret the Flet app sends in the X-API-Key header; the backend
# requires this to match on every API request. Generate a strong random value.
APP_SHARED_SECRET=

# --- Deployment / CI credentials (do NOT commit real values) ---
# GitHub personal access token (used by local gh/CI tooling if needed).
GITHUB_TOKEN=
# Clever Cloud API token (used by clever-tools for deploys).
CC_API_TOKEN=
